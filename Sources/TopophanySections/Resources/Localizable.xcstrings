    "Sign in again to this Beszel source.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Beszel ソースに再度サインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新登录此 Beszel 来源。"
          }
        }
      }
    },
    "This account cannot access the requested systems.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントは要求されたシステムにアクセスできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号无法访问所请求的系统。"
          }
        }
      }
    },
    "This account requires MFA. Use an API token in Advanced.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには MFA が必要です。「詳細」で API トークンを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号需要 MFA，请在高级选项中使用 API token。"
          }
        }
      }
    },
    "This sign-in method is not supported. Use an API token in Advanced.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この認証方法は未対応です。「詳細」で API トークンを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持此登录方式，请在高级选项中使用 API token。"
          }
        }
      }
    },
    "Could not reach the Beszel Hub. Check the address and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszel Hub に接続できません。アドレスを確認して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Beszel Hub，请检查地址后重试。"
          }
        }
      }
    },
    "The Hub certificate could not be verified. Check its certificate or CA file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hub の証明書を検証できません。証明書または CA ファイルを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证 Hub 证书，请检查证书或 CA 文件。"
          }
        }
      }
    },
    "Beszel is limiting requests. Wait before trying again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszel がリクエストを制限しています。しばらく待って再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Beszel 正在限制请求，请稍后重试。"
          }
        }
      }
    },
    "This profile changed elsewhere. Review the saved profile before retrying.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロファイルは他で変更されました。保存済みの内容を確認して再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此配置已在别处修改，请核对保存的配置后重试。"
          }
        }
      }
    },
    "This selection exceeds the supported limit. Select fewer servers.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択が上限を超えています。サーバー数を減らしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择数量超出支持上限，请减少服务器数量。"
          }
        }
      }
    },
    "Some selected systems are no longer accessible. Test the connection again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された一部のシステムにアクセスできません。接続を再テストしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分所选系统已无法访问，请重新测试连接。"
          }
        }
      }
    },
    "Discovery exceeded its limit. Try a smaller source.": {
      "localizations": {
