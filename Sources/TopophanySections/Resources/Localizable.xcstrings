        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现结果超出上限，请尝试较小的来源。"
          }
        }
      }
    },
    "The operation timed out. The saved profile will be checked before retrying.": {
      "localizations": {
