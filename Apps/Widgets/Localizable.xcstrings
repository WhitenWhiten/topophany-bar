      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての地点に合わせる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适配所有地点"
          }
        }
      }
    },
