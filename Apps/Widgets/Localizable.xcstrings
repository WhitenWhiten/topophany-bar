      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端"
          }
        }
      }
    },
    "The Whole World": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界全体"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整个世界"
          }
        }
      }
    },
    "The time where your servers are, and each one’s health.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのある場所の時刻と、それぞれの状態。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器所在地的时间，以及各自的状态。"
          }
        }
      }
    },
    "The verdict, and more of the panel as the size allows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判定と、サイズに応じてパネルのそのほかの内容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结论，以及尺寸允许时面板的更多内容。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "This Mac · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 · %@"
          }
        }
      }
    },
    "Time Zones": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムゾーン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时区"
          }
        }
      }
    },
    "What the collector concludes right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクターがいま下している判定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集器此刻得出的结论。"
          }
        }
      }
    },
    "Where your servers are, and the lines between them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのある場所と、その間のつながり。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器所在的位置，以及它们之间的连线。"
          }
        }
      }
    }
