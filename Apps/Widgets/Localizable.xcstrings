    "Native": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生"
          }
        }
      }
    },
    "Needs Attention": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要対応"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要处理"
          }
        }
      }
    },
    "Needs Attention, or Applications When Nothing Does": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要対応。なければアプリケーション"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要处理；若没有则显示应用"
          }
        }
      }
    },
    "One server's card, as in the Servers tab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 台のサーバーのカード。Servers タブと同じものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单台服务器的卡片，与 Servers 标签页中的相同。"
          }
        }
      }
    },
    "One server's card: CPU, memory and disk against its limits.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 台のサーバーのカード：CPU、メモリ、ディスクを上限と比べて表示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单台服务器的卡片：CPU、内存和磁盘，对照其上限。"
          }
        }
      }
    },
    "One service's card, as in the Services tab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのサービスのカード。Services タブと同じものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个服务的卡片，与 Services 标签页中的相同。"
          }
        }
      }
    },
    "One service's card: who sees it from where, and how fast it answered.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのサービスのカード：どこから見えるか、どれだけ速く応答したか。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个服务的卡片：从哪里可见，响应有多快。"
          }
        }
      }
    },
    "Paper": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペーパー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸张"
          }
        }
