      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーと同じ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与菜单栏相同"
          }
        }
      }
    },
