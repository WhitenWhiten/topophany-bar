{
  "sourceLanguage": "en",
  "strings": {
    "%@": {
      "shouldTranslate": false
    },
    "Applications": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリケーション"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用"
          }
        }
      }
    },
    "Native": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生"
          }
        }
      }
    },
    "Needs Attention": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要対応"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要处理"
          }
        }
      }
    },
    "Needs Attention, or Applications When Nothing Does": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要対応。なければアプリケーション"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要处理；若没有则显示应用"
          }
        }
      }
    },
    "One server's card, as in the Servers tab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 台のサーバーのカード。Servers タブと同じものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单台服务器的卡片，与 Servers 标签页中的相同。"
          }
        }
      }
    },
    "One server's card: CPU, memory and disk against its limits.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 台のサーバーのカード：CPU、メモリ、ディスクを上限と比べて表示。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单台服务器的卡片：CPU、内存和磁盘，对照其上限。"
          }
        }
      }
    },
    "Right Side": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧"
          }
        }
      }
    },
    "Same as the Menu Bar": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーと同じ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与菜单栏相同"
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        }
      }
    },
    "Status": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステータス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        }
      }
    },
    "Terminal": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端"
          }
        }
      }
    },
    "The verdict, and more of the panel as the size allows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判定と、サイズに応じてパネルのそのほかの内容。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结论，以及尺寸允许时面板的更多内容。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "This Mac · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机 · %@"
          }
        }
      }
    },
    "What the collector concludes right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクターがいま下している判定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集器此刻得出的结论。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
