      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルと同じ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与面板相同"
          }
        }
      }
    },
