            "value": "topology.json でのノード ID"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该节点在 topology.json 中的 ID"
          }
        }
      }
    },
    "The rest scrolls beneath it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかはその下でスクロールします"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其余内容在其下方滚动"
          }
        }
      }
    },
    "The services declared on this node": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このノードで宣言されたサービス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此节点上声明的服务"
          }
        }
      }
    },
    "The theme applies to the panel, the menu bar item and every widget. A later release can add themes as files: a renderer's name and its tokens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマはパネル、メニューバー項目、すべてのウィジェットに適用されます。今後のリリースでは、テーマをファイル（レンダラー名とそのトークン）として追加できるようになるかもしれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题会应用于面板、菜单栏项目和所有小组件。之后的版本可以用文件添加主题：一个渲染器名称及其 token。"
          }
        }
      }
    },
    "The time where your servers are, and each one’s health": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのある場所の時刻と、それぞれの状態"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器所在地的时间，以及各自的状态"
          }
        }
      }
    },
    "The verdict, checks by health, observers live": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "判定、健全性別のチェック、オンラインの観測点"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结论、按健康状态划分的检查、在线观测点"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机"
          }
        }
      }
    },
    "This Mac’s card from the collector, as in the Servers tab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクターから届くこの Mac のカード。Servers タブと同じものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自采集器的本机卡片，与 Servers 标签页中的相同。"
          }
        }
      }
    },
    "This is the card everyone else sees for this Mac, read from the collector. Without a host check on the node, its resources read *unknown*, never zero.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは、ほかの全員がこの Mac について見ているカードで、コレクターから読み取ります。ノードにホストチェックがなければ、リソースはゼロではなく *不明* と表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是其他所有人看到的本机卡片，从采集器读取。如果节点上没有主机检查，其资源会显示为 *未知*，而绝不是零。"
          }
        }
      }
    },
    "This topo has no monitor stream; download a newer one above": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この topo には monitor stream がありません。上で新しいものをダウンロードしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 topo 没有 monitor stream；请在上方下载较新的版本"
          }
        }
      }
    },
    "Throughput and address": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スループットとアドレス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吞吐量和地址"
          }
        }
      }
    },
    "Time zones": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイムゾーン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时区"
          }
        }
      }
    },
    "Time zones by place": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所ごとのタイムゾーン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各地点的时区"
          }
        }
      }
    },
    "Too old": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古すぎます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本过旧"
          }
        }
      }
    },
    "Topophany": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Topophany"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Topophany"
          }
        }
      }
    },
    "Topophany’s TUI at nightfall: pastels on deep indigo, boxes held by their corners, meters in braille.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日暮れの Topophany の TUI：深い藍色にパステルカラー、四隅で囲む枠、点字のメーター。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄昏时分的 Topophany TUI：深靛蓝上的柔和色彩，四角定框，点字仪表。"
          }
        }
      }
    },
    "Topophany’s TUI printed on warm paper: grain, rules and halftone meters.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かみのある紙に刷った Topophany の TUI：紙の粒子、罫線、網点のメーター。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "印在暖色纸上的 Topophany TUI：纸纹、细线与网点仪表。"
          }
        }
      }
    },
    "Topophany’s TUI: ink, phosphor and monospace, the same glyphs as topo.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Topophany の TUI：墨色、蛍光色、等幅フォント。グリフは topo と同じです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Topophany 的 TUI：墨色、荧光色与等宽字体，字形与 topo 相同。"
          }
        }
      }
    },
    "Total, system and user, with the last %lld min": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合計、システム、ユーザ。直近 %lld 分の履歴付き"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总计、系统和用户，附最近 %lld 分钟的历史"
          }
        }
      }
    },
    "Turns while what it shows is current and rests when it isn’t; a change moves once": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示が最新のあいだは回り、そうでないときは止まります。変化は一度だけ動きます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所显示的内容为最新时转动，否则静止；有变化时动一次"
          }
        }
      }
    },
    "Undo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销"
          }
        }
      }
    },
    "Unpin %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の固定を解除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消固定 %@"
          }
        }
      }
    },
    "Up to %lld pt": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt まで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最高 %lld pt"
          }
        }
      }
    },
    "Up to the screen’s height": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の高さまで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最高至屏幕高度"
          }
        }
      }
    },
    "View": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "視点"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视角"
          }
        }
      }
    },
    "What the collector shows from": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コレクターがどの観測点から見た結果を表示するか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采集器从哪个观测点的视角显示"
          }
        }
      }
    },
    "What this Mac’s observer sees: “is it me?”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac の観測点から見えるもの：「自分のせい？」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机观测点看到的情况：“是我这边的问题吗？”"
          }
        }
      }
    },
    "When the panel scrolls": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パネルがスクロールするとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当面板滚动时"
          }
        }
      }
    },
    "Where ⌘O and “more in Topophany” open the TUI": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘O と「Topophany でさらに…」で TUI を開くターミナル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘O 和“Topophany 中另有…”打开 TUI 所用的终端"
          }
        }
      }
    },
    "Which observers see a problem, and that the others don’t": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの観測点が問題を捉えているか、そしてほかの観測点は捉えていないこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些观测点发现了问题，以及其余观测点没有发现"
          }
        }
      }
    },
    "With every one ticked, the section also shows applications declared later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてにチェックを入れると、後から宣言したアプリケーションも表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部勾选时，之后声明的应用也会显示。"
          }
        }
      }
    },
    "Words": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字"
          }
        }
      }
    },
    "Your terminal opens and runs topo login, which asks for the token there. The app never sees it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルが開いて topo login を実行し、そこでトークンを尋ねます。アプリがトークンを見ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端会打开并运行 topo login，并在那里询问令牌。本应用永远看不到它。"
          }
        }
      }
    },
    "[Source](https://github.com/WhitenWhiten/topophany-bar) under the [PolyForm Noncommercial License 1.0.0](https://github.com/WhitenWhiten/topophany-bar/blob/main/LICENSE).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[ソースコード](https://github.com/WhitenWhiten/topophany-bar)は [PolyForm Noncommercial License 1.0.0](https://github.com/WhitenWhiten/topophany-bar/blob/main/LICENSE) で公開しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "[源代码](https://github.com/WhitenWhiten/topophany-bar)以 [PolyForm Noncommercial License 1.0.0](https://github.com/WhitenWhiten/topophany-bar/blob/main/LICENSE) 发布。"
          }
        }
      }
    },
    "attempt %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 回目の試行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %lld 次尝试"
          }
        }
      }
    },
    "drag to reorder": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以重新排序"
          }
        }
      }
    },
    "last frame %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終フレーム %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后一帧 %@"
          }
        }
      }
    },
    "lease until %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リース期限 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "租约至 %@"
          }
        }
      }
    },
    "macOS glass, SF Pro and system colors, like the apps beside it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のガラス、SF Pro、システムカラー。隣に並ぶアプリと同じ見た目です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 玻璃材质、SF Pro 和系统颜色，与旁边的应用一致。"
          }
        }
      }
    },
    "pid %d": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "pid %d"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "pid %d"
          }
        }
      }
    },
    "topo executable": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "topo 実行ファイル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "topo 可执行文件"
          }
        }
      }
    },
    "topo must be upgraded": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "topo のアップグレードが必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "topo 必须升级"
          }
        }
      }
    },
    "topo not found": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "topo が見つかりません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 topo"
          }
        }
      }
    }
  },
