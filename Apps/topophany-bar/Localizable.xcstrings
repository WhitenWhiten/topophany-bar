    "%@ (can’t be read)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（読み取れません）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（无法读取）"
          }
        }
      }
    },
    "%@ (matches this Mac)": {
      "localizations": {
