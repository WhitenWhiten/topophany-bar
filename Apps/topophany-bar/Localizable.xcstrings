    "3 rows": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3 行"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "3 行"
          }
        }
      }
